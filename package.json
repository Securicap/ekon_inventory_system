{
  "name": "ekon-inventory-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-ready inventory system for a small family retail business. Cloud-hosted, browser-based, append-only inventory ledger.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace frontend && npm run build --workspace backend",
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "pretypecheck": "npm run build --workspace shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build --workspace shared",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace backend",
    "migrate:status": "npm run migrate:status --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
