# Ekon Inventory System — environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
#
# Production is an installation on the shop computer — see
# docs/07-decisions/0013-local-first-shop-installation.md. There, **the
# installer writes this file**, into the installation's own data directory
# (`ProgramData\Ekon\config\ekon.env` on Windows), and the service points at it
# with EKON_CONFIG_FILE. It is not this file with the values filled in by hand,
# and it is not kept next to the application: an upgrade replaces the
# application directory wholesale and must never touch the settings.
#
# The application validates every variable at boot and refuses to start if any
# required value is missing or malformed.

# ---------------------------------------------------------------------------
# Required, in every environment
# ---------------------------------------------------------------------------

# PostgreSQL connection string. `make db-up` starts a local Postgres matching
# this default.
#
# In an installation this names the **restricted** application user — a login
# role in `ekon_app` (migration 0014), which may INSERT into the ledger and can
# never UPDATE, DELETE, or TRUNCATE it. Migrations run as the database owner,
# with a different connection string that is not stored here.
DATABASE_URL=postgres://ekon:ekon@localhost:5432/ekon_dev

# ---------------------------------------------------------------------------
# What kind of installation this is
# ---------------------------------------------------------------------------

# development | hosted | local
#
# Not the same question as NODE_ENV, which says how the code was built and how
# it logs. This says where the thing is running, and therefore which safety
# rules apply — it chooses the defaults marked below.
#
#   development   a developer's machine. Permissive defaults.
#   hosted        behind a reverse proxy that terminates TLS. The behaviour
#                 this application had before ADR 13.
#   local         installed on the shop computer. The production target.
DEPLOYMENT_PROFILE=development

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Optional — shown with their defaults
# ---------------------------------------------------------------------------

# Which interface to bind.
#   local         127.0.0.1  — nothing Ekon installs is reachable from the
#                              shop's network or from the internet
#   otherwise     0.0.0.0
HOST=0.0.0.0
PORT=3000

# Adds `Secure` to the session cookie.
#   hosted        true   — TLS is terminated in front of the application
#   otherwise     false
#
# Deliberately not derived from NODE_ENV. A local installation *is* production
# and is reached at http://127.0.0.1 by a browser on the same computer; a
# `Secure` cookie there is dropped by the browser silently, with no error and no
# warning, and nobody can sign in.
SESSION_COOKIE_SECURE=false

# TLS to PostgreSQL. `false` for local Docker, and for an installation where the
# database is on the same machine and never reached over a network. A remote or
# managed database requires `true`.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# How long to keep trying to reach the database at startup, in milliseconds,
# before giving up with a clear message. An installation starts Ekon and Ekon
# PostgreSQL together and gets no ordering guarantee, so the service waits for
# the database rather than exiting — but it is bounded, because a process that
# retries forever looks exactly like one that is working.
DATABASE_WAIT_TIMEOUT_MS=60000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Where the built frontend lives, relative to the backend package root.
STATIC_DIR=./public

# Pin the migration version this build expects. When set, the application
# refuses to start against a database at a different version, so a half-finished
# upgrade cannot accept a single inventory write.
#
# **Required** under DEPLOYMENT_PROFILE=local and =hosted, and when
# NODE_ENV=production. Development and test may leave it unset, which skips the
# check — you migrate by hand a minute earlier. An installed build normally
# supplies it through EKON_VERSION_FILE instead of setting it here.
# EXPECTED_SCHEMA_VERSION=NNNN

# Identifies the running build in /api/health and /api/system/status. `dev` is
# not an answer an installation should give; see EKON_VERSION_FILE.
APP_VERSION=dev

# All timestamps are stored in UTC and displayed in shop time for every user,
# everywhere — so the owner abroad and the employee at the counter never read
# the same movement as two different dates.
DISPLAY_TIMEZONE=America/Port-au-Prince

# ---------------------------------------------------------------------------
# Local product — the installation on the shop computer
# ---------------------------------------------------------------------------
#
# Written by the installer, not by hand and not from a copy of this file. They
# are listed here because they are configuration like everything above, and
# because an operator reading a running installation's settings should find them
# explained in the same place.
#
#   EKON_CONFIG_FILE=C:\ProgramData\Ekon\config\ekon.env
#       The file this process reads its configuration from. Set in the service
#       definition — an environment variable, not a setting inside the file it
#       names. Without it, the application walks up from its own directory
#       looking for a `.env`, which is what a developer wants and what an
#       installed service must not depend on. **A file that does not exist is a
#       boot error**, not a silent fallback.
#
#   EKON_VERSION_FILE=C:\Program Files\Ekon\version.json
#       {"appVersion": "1.4.0", "schemaVersion": "0015"} — the build's identity,
#       shipped *with the code* it describes, so an upgrade replaces the two
#       together and they cannot drift. APP_VERSION and EXPECTED_SCHEMA_VERSION
#       are taken from it, and an environment that states a different value is a
#       boot error rather than a preference to resolve.
#
#   EKON_PG_BIN=C:\Program Files\Ekon\pgsql\bin
#       The directory holding pg_dump, pg_restore, and psql. An installation
#       bundles its own PostgreSQL and must use *that* server's tools: pg_dump
#       refuses to dump a newer server than itself, and a stale client first on
#       PATH is a backup that fails at three in the morning. Unset means
#       "whatever is on PATH", which is what a developer's machine has.
#
#   EKON_BACKUP_DIR=C:\ProgramData\Ekon\backups
#       Where `ekon-ctl backup` writes dumps and their checksums.
#       **Required under DEPLOYMENT_PROFILE=local.** An installation with
#       nowhere to write a backup is one outage away from losing the business's
#       records, and the day you find out is the day it mattered.
#
#   EKON_STATE_DIR=C:\ProgramData\Ekon\state
#       Where the installation keeps state it wrote itself rather than data the
#       business entered: `last-backup.json`, which /api/system/status reports,
#       and the diagnostics bundles `ekon-ctl diagnostics` writes.
#       **Required under DEPLOYMENT_PROFILE=local.**
#
#   BACKUP_KEEP_DAILY=14
#   BACKUP_KEEP_WEEKLY=8
#       Retention. One backup is kept from each of the most recent 14 days that
#       has one, and from each of the most recent 8 ISO weeks. Days are counted
#       as *days that have a backup*, not calendar days, so a shop that was shut
#       for a fortnight comes back to its backups. A backup taken with
#       `--tag` is never pruned.
#
# The installer additionally creates the database's login user and puts it in
# `ekon_app` (migration 0014), generating its password on the machine:
#
#   CREATE ROLE ekon_runtime LOGIN PASSWORD '<generated per installation>';
#   GRANT ekon_app TO ekon_runtime;
#
# That user is what DATABASE_URL above names. The migration deliberately does
# not create it: a migration is committed to this repository, and a password is
# not.

# ---------------------------------------------------------------------------
# Hosted deployment
# ---------------------------------------------------------------------------
#
#   DEPLOYMENT_PROFILE=hosted
#       Defaults SESSION_COOKIE_SECURE to true, trusts `X-Forwarded-*` headers
#       (there is a proxy in front), and makes EXPECTED_SCHEMA_VERSION
#       mandatory. Nothing about ADR 13 forecloses hosting later; this is the
#       behaviour that was there before it.
#
#   DATABASE_SSL=true
#       For a database reached over a network. Not enforced by the application —
#       the server is what refuses the connection.

# ---------------------------------------------------------------------------
# Not application configuration
# ---------------------------------------------------------------------------
#
# `ekon-ctl create-owner` (and `npm run identity:create-owner`) read
# EKON_OWNER_USERNAME, EKON_OWNER_DISPLAY_NAME, and EKON_OWNER_PASSWORD from the
# process environment to create the first owner account. They are listed here
# only so nobody has to go looking for the names.
#
# Do NOT set them in this file. They are needed exactly once, and a config file
# persists on disk. Pass them to that one command instead — see
# backend/src/modules/identity/README.md for how to do that without leaving the
# password in your shell history.
#
# On an installed product this command is usually not needed at all: a browser
# opened against a fresh installation offers the first-run setup screen, which
# creates the owner through POST /api/setup/owner. The command remains for
# recovering an installation that has lost its owner.
