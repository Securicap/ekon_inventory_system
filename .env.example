# Ekon Inventory System — environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
#
# In production these are set in the hosting provider's environment settings,
# not in a file. The application validates all of them at boot and refuses to
# start if any required value is missing or malformed.

# ---------------------------------------------------------------------------
# Required, in every environment
# ---------------------------------------------------------------------------

# PostgreSQL connection string. `make db-up` starts a local Postgres matching
# this default.
DATABASE_URL=postgres://ekon:ekon@localhost:5432/ekon_dev

# ---------------------------------------------------------------------------
# Optional — shown with their defaults
# ---------------------------------------------------------------------------

# Also selects which rules the configuration is validated against: see the
# production section at the bottom of this file.
NODE_ENV=development

# Managed Postgres requires TLS but usually presents a certificate signed by a
# private CA. Set to `true` in production, `false` for local Docker.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Where the built frontend lives, relative to the backend package root.
STATIC_DIR=./public

# Pin the migration version this build expects. When set, the application
# refuses to start against a database at a different version, so a half-finished
# deploy cannot accept a single inventory write. Leave it unset locally, where
# you migrate by hand a minute earlier; production must set it.
# EXPECTED_SCHEMA_VERSION=NNNN

# Identifies the running build in /api/health. Production should set it to the
# deployed commit sha; `dev` is not an answer a deployed instance should give.
APP_VERSION=dev

# All timestamps are stored in UTC and displayed in shop time for every user,
# everywhere — so the owner abroad and the employee at the counter never read
# the same movement as two different dates.
DISPLAY_TIMEZONE=America/Port-au-Prince

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
#
# Set in the hosting platform's environment settings, never in a committed file,
# and never in a development `.env` — none of these is needed to run locally.
#
#   NODE_ENV=production
#       Adds `Secure` to the session cookie, switches logging to structured
#       JSON, and makes EXPECTED_SCHEMA_VERSION mandatory.
#
#   EXPECTED_SCHEMA_VERSION=NNNN
#       The head migration for this build — the four-digit prefix of the last
#       file in backend/migrations. **Enforced by the application**: with
#       NODE_ENV=production it refuses to start when this is missing, blank, or
#       not a four-digit version, and refuses to start when the database is at a
#       different version. Development and test may omit it, which skips the
#       check entirely.
#
#   DATABASE_SSL=true
#       Managed Postgres requires TLS. Not enforced by the application — the
#       provider is what refuses the connection.
#
#   APP_VERSION=<commit sha>
#       Reported by /api/health, and how a deploy is identified. Not enforced by
#       the application; it defaults to `dev`.

# ---------------------------------------------------------------------------
# Not application configuration
# ---------------------------------------------------------------------------
#
# `npm run identity:create-owner` reads EKON_OWNER_USERNAME,
# EKON_OWNER_DISPLAY_NAME, and EKON_OWNER_PASSWORD from the process environment
# to create the first owner account on a new installation. They are listed here
# only so nobody has to go looking for the names.
#
# Do NOT set them in `.env`. They are needed exactly once, and `.env` persists on
# disk. Pass them to that one command instead — see
# backend/src/modules/identity/README.md for how to do that without leaving the
# password in your shell history.
