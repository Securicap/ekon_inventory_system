# Ekon Inventory System — environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
#
# In production these are set in the hosting provider's environment settings,
# not in a file. The application validates all of them at boot and refuses to
# start if any required value is missing or malformed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. `make db-up` starts a local Postgres matching
# this default.
DATABASE_URL=postgres://ekon:ekon@localhost:5432/ekon_dev

# ---------------------------------------------------------------------------
# Optional — shown with their defaults
# ---------------------------------------------------------------------------

NODE_ENV=development

# Managed Postgres requires TLS but usually presents a certificate signed by a
# private CA. Set to `true` in production, `false` for local Docker.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Where the built frontend lives, relative to the backend package root.
STATIC_DIR=./public

# Pin the migration version this build expects. When set, the application
# refuses to start against a database at a different version, so a half-finished
# deploy cannot accept a single inventory write. Set this in production; leave it
# unset locally.
# EXPECTED_SCHEMA_VERSION=0001

# Identifies the running build in /api/health.
APP_VERSION=dev

# All timestamps are stored in UTC and displayed in shop time for every user,
# everywhere — so the owner abroad and the employee at the counter never read
# the same movement as two different dates.
DISPLAY_TIMEZONE=America/Port-au-Prince
