# Ekon production-candidate configuration for the OCI VM.
#
#   cp production.env.example production.env
#   chmod 600 production.env
#
# `production.env` is gitignored and must never be committed. Every value below
# is a placeholder.
#
# What is NOT here, deliberately:
#
#   APP_VERSION              derived by scripts/deploy.sh from the deployed commit
#   EXPECTED_SCHEMA_VERSION  derived by scripts/deploy.sh from that commit's migrations
#   DATABASE_URL             built by compose.yaml from the three POSTGRES_* values
#
# A value an operator retypes is a value that can disagree with the build. The
# staging environment reported `"version": "staging"` for weeks while serving an
# old commit, and nobody could tell. Nothing in this file can cause that.
#
# The owner's password is not here either — it is needed once, and a file
# persists. See the bootstrap step in docs/06-operations/oci-zero-cost.md.

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------

# The hostname whose DNS A/AAAA record points at this VM's public IP. Caddy
# obtains a certificate for exactly this name.
EKON_DOMAIN=inventory.example.com

# Where Let's Encrypt sends expiry warnings. A real, monitored address.
EKON_ACME_EMAIL=owner@example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# These three are read by the postgres container on first start and are what
# create the database. Changing POSTGRES_PASSWORD later does NOT change the
# password of an already-initialized database — see the runbook.
#
# Generate the password with:  openssl rand -hex 32
#
# Use hex or base64url only. compose.yaml builds DATABASE_URL by string
# substitution, so a password containing : / @ ? # or % would produce a
# malformed connection string; deploy.sh refuses one rather than letting the
# application fail to connect for a reason nobody would guess.

POSTGRES_DB=ekon
POSTGRES_USER=ekon
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# One small VM, one application container, PostgreSQL on the same host. Ten
# connections is generous for a shop and well under Postgres's default 100.
DATABASE_POOL_MAX=10

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Every timestamp is stored in UTC and displayed in shop time, so the owner
# abroad and the employee at the counter read the same movement as one date.
DISPLAY_TIMEZONE=America/Port-au-Prince

# ---------------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------------

# Where the block volume is mounted. postgres/, caddy/ and backups/ live under
# it. Leave as-is unless the runbook was followed with a different path.
EKON_STATE_DIR=/srv/ekon

# ---------------------------------------------------------------------------
# Backups — OCI Object Storage
# ---------------------------------------------------------------------------
#
# The VM authenticates with an *instance principal*: its identity comes from the
# instance itself through a dynamic group and a narrow Object Storage policy.
# There is no API key, no private key, and no tenancy OCID on this machine or in
# this repository. See the runbook for the dynamic group and policy.

OCI_BACKUP_BUCKET=ekon-backups

# Optional. `oci os ns get` resolves it at runtime when this is unset; setting
# it saves one API call per backup. It is not a secret, but it identifies the
# tenancy, so it stays out of Git.
# OCI_BACKUP_NAMESPACE=

# Optional. Only needed if the bucket is not in the instance's own region.
# OCI_REGION=us-ashburn-1

# How many completed local backups to keep, pruned only after the matching
# remote upload has succeeded. Remote retention is an Object Storage lifecycle
# rule, not something this script deletes.
BACKUP_LOCAL_KEEP=7
