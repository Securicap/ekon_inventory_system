# dependencies
node_modules/

# build output
dist/
backend/public/
*.tsbuildinfo

# the assembled Windows application layout, and the pinned artifacts it unpacks.
# Both are build output: `scripts/windows/build-layout.mjs` rebuilds the tree
# from scratch every run, and the cache is a few hundred megabytes of Node and
# PostgreSQL zips that are pinned by checksum in versions.json anyway.
dist-windows/
.cache/

# environment — never commit real credentials
.env
.env.*
!.env.example

# the archived hosted candidate's real configuration: database password, domain,
# backup bucket. `.env.*` above does not match it, so it is named explicitly, and
# it stays ignored so an old working copy cannot commit one.
deploy/archive/oci/production.env
deploy/oci/production.env

# local database / postgres scratch
pgdata/
*.dump
*.sql.gz

# logs
*.log
npm-debug.log*

# test artifacts
coverage/
playwright-report/
test-results/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
